# Application
APP_NAME="SRHR Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost:3000
PUBLIC_PORTAL_ENABLED=true
MFA_ENABLED=false
SESSION_LIFETIME=120

# Database
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=srhr_portal
DB_USERNAME=srhr
DB_PASSWORD=secret

# Redis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# MinIO / Object Storage
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=srhr-portal
MINIO_REGION=us-east-1
STORAGE_DRIVER=s3
EXPORT_STORAGE_DISK=s3

# Mail
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@srhrportal.org
MAIL_FROM_NAME="${APP_NAME}"

# AI Integration
AI_PROVIDER=anthropic
AI_API_KEY=

# Queue
QUEUE_CONNECTION=redis

# Cache
CACHE_DRIVER=redis
