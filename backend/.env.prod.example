APP_NAME="SRHR Portal"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://srhr.sadcpf.org

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=srhr_portal
DB_USERNAME=srhr
DB_PASSWORD=STRONG_PASSWORD_HERE

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=srhr.sadcpf.org

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=STRONG_REDIS_PASSWORD
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=YOUR_SMTP_USER
MAIL_PASSWORD=YOUR_SMTP_PASSWORD
MAIL_FROM_ADDRESS="noreply@srhr.sadcpf.org"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=YOUR_MINIO_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_MINIO_SECRET_KEY
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=srhr-portal
AWS_ENDPOINT=https://srhr.sadcpf.org:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
